# Generate unique values with scripts/bootstrap_secrets.sh; no shared passwords.
POSTGRES_DB=mulenet
POSTGRES_USER=mulenet_migrator
POSTGRES_PASSWORD=
MULENET_DB_PASSWORD=
REDIS_PASSWORD=
KAFKA_CLUSTER_ID=
MULENET_TOKEN_KEY=
MULENET_ENCRYPTION_KEY=
MULENET_SERVICE_SECRET=
MULENET_STREAM_SECRET=
MULENET_INGESTION_SECRET=
MULENET_DEMO_JWT_SECRET=
MULENET_DEMO_ANALYST_PASSWORD=
MULENET_DEMO_SUPERVISOR_PASSWORD=
MULENET_DEMO_ADMIN_PASSWORD=
MULENET_DEMO_AUDITOR_PASSWORD=
KEYCLOAK_ADMIN=installation-admin
KEYCLOAK_ADMIN_PASSWORD=
SPRING_PROFILES_ACTIVE=platform
MULENET_ALLOW_SYNTHETIC=false
MULENET_REGISTRY_ROOT=./artifacts
MULENET_ACTIVE_MODEL=REQUIRED_APPROVED_MODEL
MULENET_OIDC_ISSUER=
# Exact browser-visible issuer origin (no path), allowed by the console CSP.
# Leave empty for the explicitly enabled local demo; never use a wildcard.
MULENET_OIDC_BROWSER_ORIGIN=
MULENET_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
